              "name": "tipo_consulta",
              "value": "={{ (() => { try { return JSON.parse($('AI Agent').first().json.output) } catch (e) { return {} } })().tipo_consulta || 'otro' }}",
              "type": "string"
            },
            {
              "id": "459a6fe3-456c-4ee2-960f-81d5deaa8788",
              "name": "respuesta_cliente",
              "value": "={{ (() => { try { return JSON.parse($('AI Agent').first().json.output) } catch (e) { return {} } })().respuesta_cliente || 'Gracias por tu consulta. Una persona del equipo te va a responder a la brevedad.' }}",
              "type": "string"
            },
            {
              "id": "e6e544cd-4d17-422e-9d7f-cd202014dbed",
              "name": "resumen_equipo",
